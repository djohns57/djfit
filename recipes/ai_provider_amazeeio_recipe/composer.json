{
  "name": "drupal/ai_provider_amazeeio_recipe",
  "description": "Automates the setup of the amazee.ai AI provider.",
  "type": "drupal-recipe",
  "license": "GPL-2.0-or-later",
  "require": {
    "drupal/core": ">=10.4",
    "drupal/ai": "~1.2.0",
    "drupal/ai_provider_amazeeio": "~1.2.3"
  },
  "conflict": {
    "drupal/project_browser": "<2-alpha7"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\Tests\\ai_provider_amazeeio_recipe\\Composer\\": "tests/src/Composer/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "Drupal\\Tests\\ai_provider_amazeeio_recipe\\Composer\\SymlinkTestModule::ensure"
    ],
    "post-update-cmd": [
      "Drupal\\Tests\\ai_provider_amazeeio_recipe\\Composer\\SymlinkTestModule::ensure"
    ]
  }
}
