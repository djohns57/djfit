{% extends 'block.html.twig' %}
{#
/**
 * @file
 * Theme override for a branding block.
 *
 * Renders the JPS Enterprise logo image + site name as a branding unit.
 * Logo uses the actual PNG from Figma (node 1:329), displayed at 40x40.
 *
 * Available variables:
 * - site_logo: Logo for site as defined in Appearance or theme settings.
 * - site_name: Name for site as defined in Site information settings.
 * - site_slogan: Slogan for site as defined in Site information settings.
 */
#}

{% block content %}
  <a href="{{ path('<front>') }}" class="branding-link" rel="home" aria-label="{{ site_name|default('Home') }}">
    <span class="branding-logo">
      <img
        src="/{{ active_theme_path() }}/components/site-header/assets/logo-jps-enterprise.png"
        alt="{{ site_name|default('JPS Enterprise') }}"
        width="40"
        height="40"
        loading="eager"
        class="branding-logo__img"
      />
    </span>
    {% if site_name %}
      <span class="branding-site-name">{{ site_name }}</span>
    {% endif %}
  </a>
{% endblock %}
