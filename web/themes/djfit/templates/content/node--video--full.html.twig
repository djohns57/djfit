{#
/**
 * @file
 * Theme override for Video node full display.
 *
 * Renders embedded video player, description, metadata and related info
 * in a styled layout matching the DJ Fit design language.
 */
#}
{% set category_term = node.field_video_category.entity %}
{% set category_name = category_term ? category_term.label : '' %}
{% set duration = node.field_video_duration.value ?? '' %}
{% set access = node.field_video_access.value ?? 'free' %}
{% set description = node.field_video_description.value ?? '' %}

<article class="video-detail" {{ attributes }}>
  {# Video player #}
  <div class="video-detail__player">
    {{ content.field_video_media }}
  </div>

  <div class="video-detail__container">
    {# Meta bar #}
    <div class="video-detail__meta">
      {% if category_name %}
        <span class="video-detail__category">{{ category_name }}</span>
      {% endif %}
      {% if duration %}
        <span class="video-detail__duration">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            <polyline points="12,6 12,12 16,14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {{ duration }}
        </span>
      {% endif %}
      <span class="video-detail__access video-detail__access--{{ access }}">
        {% if access == 'members_only' %}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Members Only
        {% else %}
          Free
        {% endif %}
      </span>
    </div>

    {# Title #}
    <h1 class="video-detail__title">{{ label }}</h1>

    {# Description #}
    {% if description %}
      <div class="video-detail__description">
        {{ content.field_video_description }}
      </div>
    {% endif %}

    {# Back to library #}
    <div class="video-detail__back">
      <a href="/videos" class="video-detail__back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12.6667 8H3.33333" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 12.6667L3.33333 8L8 3.33333" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Video Library
      </a>
    </div>
  </div>
</article>
