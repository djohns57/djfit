{#
/**
 * @file
 * DJ Fit theme override for the Commerce product template.
 *
 * Available variables:
 * - attributes: HTML attributes for the <article> wrapper.
 * - product: Rendered product fields. Print all via {{ product }}, or
 *   selectively via {{ product.field_name }}.
 * - product_entity: The raw product entity object.
 * - product_url: Canonical URL for the product.
 * - title_prefix / title_suffix: Module-injected content around the title.
 *
 * Note: variation_attributes (color/size selectors) are excluded from the
 * default product output and rendered inline by the add-to-cart form.
 */
#}
<article{{ attributes.addClass('commerce-product', 'commerce-product--full') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  <div class="commerce-product__main">
    <h1 class="commerce-product__title">{{ product_entity.title.value }}</h1>
    <div class="commerce-product__purchase">
      <div class="commerce-product__price">
        {{ product.variation_price }}
      </div>
      <div class="commerce-product__cart">
        {{ product.variations }}
      </div>
    </div>
  </div>
  {{- product|without('variation_attributes', 'variations', 'title', 'variation_price', 'variation_list_price') -}}
</article>
