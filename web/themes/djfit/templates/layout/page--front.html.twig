{#
/**
 * @file
 * Theme override for the front page.
 *
 * Renders the home-hero SDC component below the site header,
 * then the rest of the page content.
 */
#}
<div class="layout-container">
  <header role="banner">
    {{ page.header }}
  </header>

  {{ page.highlighted }}
  {{ page.help }}

  <main role="main">
    <a id="main-content" tabindex="-1"></a>

    {# Home Hero section – Figma node 1:5 #}
    {% include 'djfit:home-hero' with {
      heading: 'Health, Strength & Longevity for Men Over 40',
      body: 'Science-backed fitness, nutrition, and recovery strategies designed specifically for your stage of life.',
      primary_button_label: 'Membership Plans',
      primary_button_url: '/membership',
      secondary_button_label: 'Learn More',
      secondary_button_url: '/about',
    } %}

    <div class="layout-content">
      {{ page.content }}
    </div>
  </main>

  {% if page.footer %}
    <footer role="contentinfo">
      {{ page.footer }}
    </footer>
  {% endif %}
</div>
