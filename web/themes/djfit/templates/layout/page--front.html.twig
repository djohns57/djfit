{#
/**
 * @file
 * Theme override for the front page.
 *
 * Renders the home-hero SDC component below the site header,
 * then the rest of the page content.
 */
#}
<div class="layout-container">
  <header role="banner">
    {{ page.header }}
  </header>

  {{ page.highlighted }}
  {{ page.help }}

  <main role="main">
    <a id="main-content" tabindex="-1"></a>

    {# Home Hero section – Figma node 1:5 #}
    {% include 'djfit:home-hero' with {
      heading: 'Health, Strength & Longevity for Men Over 40',
      body: 'Science-backed fitness, nutrition, and recovery strategies designed specifically for your stage of life.',
      primary_button_label: 'Membership Plans',
      primary_button_url: '/membership',
      secondary_button_label: 'Learn More',
      secondary_button_url: '/blog',
      hero_image_url: '/sites/default/files/hero-runner.png',
      hero_image_alt: 'Fit man running outdoors with palm trees',
    } %}

    {# Home Features section – Figma node 1:27 #}
    {% include 'djfit:home-features' %}

    {# Latest Articles section – Figma node 1:60 #}
    {% include 'djfit:home-articles' %}

    {# Featured Videos section – Figma node 1:139 #}
    {% include 'djfit:home-videos' %}

    {# Testimonials section – Figma node 1:186 #}
    {% include 'djfit:home-testimonials' %}

    {# CTA section – Figma node 1:254 #}
    {% include 'djfit:home-cta' %}

    {# Additional homepage sections will be added here as built #}
  </main>

  {# Custom footer – Figma node 1:280 #}
  {% include 'djfit:home-footer' %}
</div>
