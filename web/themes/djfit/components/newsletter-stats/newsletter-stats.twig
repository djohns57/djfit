{#
/**
 * @file
 * Newsletter stats – four key numbers on a gradient background.
 */
#}
<section class="nl-stats">
  <div class="nl-stats__grid">
    <div class="nl-stats__item">
      <span class="nl-stats__value">{{ stat_1_value }}</span>
      <span class="nl-stats__label">{{ stat_1_label }}</span>
    </div>

    <div class="nl-stats__item">
      <span class="nl-stats__value">{{ stat_2_value }}</span>
      <span class="nl-stats__label">{{ stat_2_label }}</span>
    </div>

    <div class="nl-stats__item">
      <span class="nl-stats__value">{{ stat_3_value }}</span>
      <span class="nl-stats__label">{{ stat_3_label }}</span>
    </div>

    <div class="nl-stats__item">
      <span class="nl-stats__value">{{ stat_4_value }}</span>
      <span class="nl-stats__label">{{ stat_4_label }}</span>
    </div>
  </div>
</section>
