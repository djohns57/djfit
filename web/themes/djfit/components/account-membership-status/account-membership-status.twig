{% set is_active = (status|default('active')) in ['active', 'trialing'] ? 'yes' : 'no' %}

{% set status_box =
  html_cva(
    base: ['account-membership-status rounded-sm border p-5 md:p-6'],
    variants: {
      active: {
        yes: ['border-primary/30 bg-primary/5 text-foreground'],
        no: ['border-border bg-muted/30 text-foreground']
      }
    }
  )
%}

{% set status_badge =
  html_cva(
    base: ['inline-flex rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase'],
    variants: {
      active: {
        yes: ['bg-primary text-primary-foreground'],
        no: ['bg-muted text-muted-foreground']
      }
    }
  )
%}

<section
  class="{{
  status_box.apply({
    active: is_active
  })
  }}"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-3">
      <span
        class="{{
        status_badge.apply({
          active: is_active
        })
        }}"
      >
        {{
          status
            |default('active')
            |replace({
              '_': ' '
            })
        }}
      </span>

      {{
        include(
          'djfit:heading',
          {
            heading_text: plan_name|default('Pro Monthly'),
            level: 3,
            text_color: 'default',
            text_size: 'heading-responsive-3xl',
            url: 'No URL',
            align: 'left'
          },
          with_context: false
        )
      }}

      <p class="text-sm text-muted-foreground md:text-base">
        {{ renewal_text|default('Renews on the 15th of each month.') }}
      </p>
    </div>

    <div class="shrink-0">
      {{
        include(
          'djfit:button',
          {
            href: button_url|default('/user'),
            label: button_label|default('Manage billing'),
            variant: 'secondary',
            size: 'medium'
          },
          with_context: false
        )
      }}
    </div>
  </div>
</section>
