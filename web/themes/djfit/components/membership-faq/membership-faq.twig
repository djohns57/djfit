{#
/**
 * @file
 * Membership FAQ – expandable question & answer cards.
 */
#}
{% set faqs = [
  { question: 'Can I cancel anytime?', answer: 'Yes, you can cancel your membership at any time. There are no long-term contracts or cancellation fees.' },
  { question: "What's included in the 30-day guarantee?", answer: "If you're not satisfied within the first 30 days, we'll refund your payment in full, no questions asked." },
  { question: 'Can I upgrade from Basic to Pro?', answer: 'Absolutely! You can upgrade at any time and only pay the prorated difference.' },
  { question: 'Do you offer group or family discounts?', answer: 'Yes! Contact our support team for information on group pricing for 3+ members.' },
  { question: 'Is this suitable for beginners?', answer: 'Definitely. Our programs are designed for all fitness levels, with modifications and progressions provided for every exercise.' },
] %}

<section class="membership-faq">
  <div class="membership-faq__container">
    <h2 class="membership-faq__heading">{{ heading }}</h2>
    <div class="membership-faq__list">
      {% for faq in faqs %}
        <div class="membership-faq__item">
          <h4 class="membership-faq__question">{{ faq.question }}</h4>
          <p class="membership-faq__answer">{{ faq.answer }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
