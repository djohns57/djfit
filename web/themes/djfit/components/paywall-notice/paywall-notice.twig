<aside class="paywall-notice rounded-sm border border-border bg-card p-6 text-card-foreground shadow-sm">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-6">
    <div class="max-w-2xl">
      {{
        include(
          'djfit:heading',
          {
            heading_text: heading_text|default('This content is for members'),
            level: 3,
            text_color: 'default',
            text_size: 'heading-responsive-3xl',
            url: 'No URL',
            align: 'left'
          },
          with_context: false
        )
      }}
      <p class="mt-2 text-sm text-muted-foreground md:text-base">
        {{ body_text|default('Join now to access workouts, nutrition plans, and community support.') }}
      </p>
    </div>

    <div class="shrink-0">
      {{
        include(
          'djfit:button',
          {
            href: button_url|default('/membership'),
            label: button_label|default('View membership plans'),
            variant: 'primary',
            size: 'medium'
          },
          with_context: false
        )
      }}
    </div>
  </div>
</aside>
