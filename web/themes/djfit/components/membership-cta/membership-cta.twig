{#
/**
 * @file
 * Membership CTA – full-width gradient call-to-action banner.
 */
#}
<section class="membership-cta">
  <div class="membership-cta__container">
    <h2 class="membership-cta__heading">{{ heading }}</h2>
    <p class="membership-cta__subtitle">{{ subtitle }}</p>
    <div class="membership-cta__actions">
      <a href="{{ primary_cta_url }}" class="membership-cta__btn membership-cta__btn--primary">{{ primary_cta_text }}</a>
      <a href="{{ secondary_cta_url }}" class="membership-cta__btn membership-cta__btn--secondary">{{ secondary_cta_text }}</a>
    </div>
  </div>
</section>
