{#
/**
 * @file
 * Newsletter FAQ – expandable question/answer cards.
 */
#}
<section class="nl-faq">
  <h2 class="nl-faq__heading">{{ heading }}</h2>
  <div class="nl-faq__list">
    <details class="nl-faq__item" open>
      <summary class="nl-faq__question">
        {{ q1 }}
      </summary>
      <p class="nl-faq__answer">
        {{ a1 }}
      </p>
    </details>

    <details class="nl-faq__item" open>
      <summary class="nl-faq__question">
        {{ q2 }}
      </summary>
      <p class="nl-faq__answer">
        {{ a2 }}
      </p>
    </details>

    <details class="nl-faq__item" open>
      <summary class="nl-faq__question">
        {{ q3 }}
      </summary>
      <p class="nl-faq__answer">
        {{ a3 }}
      </p>
    </details>

    <details class="nl-faq__item" open>
      <summary class="nl-faq__question">
        {{ q4 }}
      </summary>
      <p class="nl-faq__answer">
        {{ a4 }}
      </p>
    </details>
  </div>
</section>
