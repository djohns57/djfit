        </a>
      </div>
    </div>

    {# Quick Links column #}
    <nav class="home-footer__nav" aria-label="Quick Links">
      <h4 class="home-footer__nav-heading">Quick Links</h4>
      <ul class="home-footer__nav-list">
        <li><a href="/blog" class="home-footer__nav-link">Blog</a></li>
        <li><a href="/videos" class="home-footer__nav-link">Video Library</a></li>
        <li><a href="/resources" class="home-footer__nav-link">Resources</a></li>
        <li><a href="/membership" class="home-footer__nav-link">Membership</a></li>
      </ul>
    </nav>

    {# Legal column #}
    <nav class="home-footer__nav" aria-label="Legal">
      <h4 class="home-footer__nav-heading">Legal</h4>
      <ul class="home-footer__nav-list">
        <li><a href="/privacy" class="home-footer__nav-link">Privacy Policy</a></li>
        <li><a href="/terms" class="home-footer__nav-link">Terms of Service</a></li>
        <li><a href="/cookies" class="home-footer__nav-link">Cookie Policy</a></li>
        <li><a href="/contact" class="home-footer__nav-link">Contact Us</a></li>
      </ul>
    </nav>
  </div>

  {# Copyright bar #}
  <div class="home-footer__bottom">
    <p class="home-footer__copyright">{{ _copy }}</p>
  </div>
</footer>
