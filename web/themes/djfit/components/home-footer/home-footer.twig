{% set _brand = brand_name|default('DJ Fit') %}
{% set _desc = brand_description|default('Health, strength, and longevity for men over 40. Science-backed fitness, nutrition, and recovery strategies.') %}
{% set _fb = facebook_url|default('#') %}
{% set _tw = twitter_url|default('#') %}
{% set _ig = instagram_url|default('#') %}
{% set _copy = copyright_text|default('© 2026 DJ Fit. All rights reserved.') %}

<footer class="home-footer" role="contentinfo">
  <div class="home-footer__top">
    {# Brand column #}
    <div class="home-footer__brand">
      <div class="home-footer__brand-row">
        <img src="/{{ active_theme_path() }}/components/logo-jps-enterprise/assets/logo-jps.svg" alt="{{ _brand }} logo" class="home-footer__logo" width="48" height="48" />
        <span class="home-footer__brand-name">{{ _brand }}</span>
      </div>
      <p class="home-footer__brand-desc">{{ _desc }}</p>
      <div class="home-footer__social">
        <a href="{{ _fb }}" class="home-footer__social-link" aria-label="Facebook">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
