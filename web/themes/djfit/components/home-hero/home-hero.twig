{#
/**
 * @file
 * Home Hero component.
 *
 * Renders the homepage hero section with gradient background,
 * heading, body text, CTA buttons, and optional hero image.
 * Matches Figma node 1:5.
 *
 * Props:
 *   - heading: string - Main heading text
 *   - body: string - Supporting paragraph
 *   - primary_button_label: string - Primary CTA label
 *   - primary_button_url: string - Primary CTA URL
 *   - secondary_button_label: string - Secondary CTA label
 *   - secondary_button_url: string - Secondary CTA URL
 *   - hero_image_url: string - Optional hero image
 *   - hero_image_alt: string - Alt text for hero image
 */
#}
{% set heading = heading|default('Health, Strength & Longevity for Men Over 40') %}
{% set body = body|default('Science-backed fitness, nutrition, and recovery strategies designed specifically for your stage of life.') %}
{% set primary_button_label = primary_button_label|default('Membership Plans') %}
{% set primary_button_url = primary_button_url|default('/membership') %}
{% set secondary_button_label = secondary_button_label|default('Learn More') %}
{% set secondary_button_url = secondary_button_url|default('/about') %}

<section class="home-hero">
  <div class="home-hero__container">

    {# Left content: heading, body, buttons #}
    <div class="home-hero__content">
      <h1 class="home-hero__heading">{{ heading }}</h1>
      <p class="home-hero__body">{{ body }}</p>
      <div class="home-hero__actions">
        <a href="{{ primary_button_url }}" class="home-hero__btn home-hero__btn--primary">
          {{ primary_button_label }}
          <svg class="home-hero__btn-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3.33333 8H12.6667" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 3.33333L12.6667 8L8 12.6667" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="{{ secondary_button_url }}" class="home-hero__btn home-hero__btn--secondary">
          {{ secondary_button_label }}
        </a>
      </div>
    </div>

    {# Right side: hero image #}
    {% if hero_image_url %}
      <div class="home-hero__image-wrapper">
        <img
          src="{{ hero_image_url }}"
          alt="{{ hero_image_alt|default('') }}"
          class="home-hero__image"
          loading="eager"
        />
      </div>
    {% else %}
      <div class="home-hero__image-wrapper home-hero__image-placeholder">
        <svg class="home-hero__placeholder-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="8.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M3 16L8 11L13 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M14 15L17 12L21 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    {% endif %}

  </div>
</section>
