{#
/**
 * @file
 * Resources hero banner – gradient background matching the DJ Fit design.
 */
#}
{% set heading = heading|default('Templates & Guides') %}
{% set subtitle = subtitle|default('Downloadable resources to support your fitness journey. Workout plans, nutrition guides, and tracking tools.') %}

<section class="resources-hero">
  <div class="resources-hero__container">
    <h2 class="resources-hero__heading">{{ heading }}</h2>
    <p class="resources-hero__subtitle">
      {{ subtitle }}
    </p>
  </div>
</section>
