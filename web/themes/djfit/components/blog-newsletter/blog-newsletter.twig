{#
/**
 * @file
 * Blog newsletter CTA – Figma node 2:321
 */
#}
{% set _heading = heading|default('Never Miss an Article') %}
{% set _subtitle = subtitle|default('Get the latest articles delivered directly to your inbox every week.') %}
{% set _label = button_label|default('Subscribe to Newsletter') %}
{% set _url = button_url|default('/newsletter') %}

<section class="blog-newsletter">
  <div class="blog-newsletter__container">
    <h2 class="blog-newsletter__heading">{{ _heading }}</h2>
    <p class="blog-newsletter__subtitle">
      {{ _subtitle }}
    </p>
    <a href="{{ _url }}" class="blog-newsletter__btn">{{ _label }}</a>
  </div>
</section>
