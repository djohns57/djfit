{#
/**
 * @file
 * Newsletter testimonials – three subscriber quote cards.
 */
#}
<section class="nl-testimonials">
  <h2 class="nl-testimonials__heading">{{ heading }}</h2>
  <div class="nl-testimonials__grid">

    <div class="nl-testimonials__card">
      <p class="nl-testimonials__quote">{{ quote_1 }}</p>
      <p class="nl-testimonials__author">{{ author_1 }}</p>
    </div>

    <div class="nl-testimonials__card">
      <p class="nl-testimonials__quote">{{ quote_2 }}</p>
      <p class="nl-testimonials__author">{{ author_2 }}</p>
    </div>

    <div class="nl-testimonials__card">
      <p class="nl-testimonials__quote">{{ quote_3 }}</p>
      <p class="nl-testimonials__author">{{ author_3 }}</p>
    </div>

  </div>
</section>
