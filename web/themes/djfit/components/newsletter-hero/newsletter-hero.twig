{#
/**
 * @file
 * Newsletter hero – gradient banner with envelope icon, heading, subtitle.
 */
#}
<section class="nl-hero">
  <div class="nl-hero__icon-wrap">
    <svg
      class="nl-hero__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="M22 4L12 13 2 4" />
    </svg>
  </div>
  <h2 class="nl-hero__heading">{{ heading }}</h2>
  <p class="nl-hero__subtitle">
    {{ subtitle }}
  </p>
</section>
