{#
/**
 * @file
 * Home Articles section – "Latest Articles" with dynamic article cards.
 *
 * Figma node 1:60.
 *
 * Section header props come from Canvas; article cards are sourced dynamically
 * from the djfit_home_articles block (queries the 3 most recent Article nodes).
 */
#}
{% set section_heading = section_heading|default('Latest Articles') %}
{% set section_subtitle = section_subtitle|default('Expert insights and actionable advice') %}
{% set view_all_url = view_all_url|default('/blog') %}

<section class="home-articles">
  {# Section header – editable via Canvas props #}
  <div class="home-articles__header">
    <div class="home-articles__header-text">
      <h2 class="home-articles__title">{{ section_heading }}</h2>
      <p class="home-articles__subtitle">
        {{ section_subtitle }}
      </p>
    </div>
    <a href="{{ view_all_url }}" class="home-articles__view-all">View All</a>
  </div>

  {# Dynamic article cards from Article nodes #}
  {{ drupal_block('djfit_home_articles') }}
</section>
