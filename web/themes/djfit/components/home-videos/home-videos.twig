{#
/**
 * @file
 * Home Videos section – "Featured Videos" with 2 video cards.
 *
 * Figma node 1:139.
 *
 * Props (flat for Canvas):
 *   - section_heading, section_subtitle, library_url
 *   - video[1-2]_heading, video[1-2]_body, video[1-2]_url,
 *     video[1-2]_image_url, video[1-2]_badge, video[1-2]_locked
 */
#}
{% set section_heading = section_heading|default('Featured Videos') %}
{% set section_subtitle = section_subtitle|default('Watch and learn from our expert trainers') %}
{% set library_url = library_url|default('/videos') %}

{% set videos = [
  {
    heading: video1_heading|default('Complete Full Body Workout - 30 Minutes'),
    body: video1_body|default('Efficient strength training for busy professionals'),
    url: video1_url|default('/videos/full-body-workout'),
    image_url: video1_image_url|default(''),
    badge: video1_badge|default('FREE'),
    locked: video1_locked|default('no') == 'yes',
  },
  {
    heading: video2_heading|default('Advanced Mobility and Recovery Protocol'),
    body: video2_body|default('Premium content for enhanced flexibility and injury prevention'),
    url: video2_url|default('/videos/mobility-recovery'),
    image_url: video2_image_url|default(''),
    badge: video2_badge|default('MEMBERS'),
    locked: video2_locked|default('yes') == 'yes',
  },
] %}

<section class="home-videos">
  {# Section header #}
  <div class="home-videos__header">
    <div class="home-videos__header-text">
      <h2 class="home-videos__title">{{ section_heading }}</h2>
      <p class="home-videos__subtitle">{{ section_subtitle }}</p>
    </div>
    <a href="{{ library_url }}" class="home-videos__library-btn">Video Library</a>
  </div>

  {# Video cards grid #}
  <div class="home-videos__grid">
    {% for video in videos %}
      <a href="{{ video.url }}" class="home-videos__card" aria-label="{{ video.heading }}">
        {# Thumbnail area #}
        <div class="home-videos__media">
          {% if video.image_url %}
            <img src="{{ video.image_url }}" alt="{{ video.heading }}" class="home-videos__thumb" loading="lazy" />
          {% else %}
            <div class="home-videos__placeholder">
              <svg class="home-videos__placeholder-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="8.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                <path d="M3 16L8 11L13 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M14 15L17 12L21 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {% endif %}

          {# Dark overlay with play/lock icon #}
          <div class="home-videos__overlay">
            <div class="home-videos__play-btn">
              {% if video.locked %}
                {# Lock icon #}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="home-videos__icon">
                  <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
                  <path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              {% else %}
                {# Play icon #}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="home-videos__icon">
                  <polygon points="5,3 19,12 5,21" fill="currentColor"/>
                </svg>
              {% endif %}
            </div>
          </div>

          {# Badge #}
          <span class="home-videos__badge home-videos__badge--{{ video.badge|lower }}">
            {{ video.badge }}
          </span>
        </div>

        {# Card content #}
        <div class="home-videos__content">
          <h4 class="home-videos__card-heading">{{ video.heading }}</h4>
          <p class="home-videos__card-body">{{ video.body }}</p>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
