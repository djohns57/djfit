{#
/**
 * @file
 * Home Videos section – "Featured Videos" with dynamic video cards.
 *
 * Figma node 1:139.
 *
 * Section header props come from Canvas; video cards are sourced dynamically
 * from the djfit_home_videos block (queries the 2 most recent/featured Video nodes).
 */
#}
{% set section_heading = section_heading|default('Featured Videos') %}
{% set section_subtitle = section_subtitle|default('Watch and learn from our expert trainers') %}
{% set library_url = library_url|default('/videos') %}

<section class="home-videos">
  {# Section header – editable via Canvas props #}
  <div class="home-videos__header">
    <div class="home-videos__header-text">
      <h2 class="home-videos__title">{{ section_heading }}</h2>
      <p class="home-videos__subtitle">{{ section_subtitle }}</p>
    </div>
    <a href="{{ library_url }}" class="home-videos__library-btn">Video Library</a>
  </div>

  {# Dynamic video cards from Video nodes #}
  {{ drupal_block('djfit_home_videos') }}
</section>
