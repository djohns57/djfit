<section class="membership-pricing-table flex flex-col gap-6 md:gap-8">
  <header class="mx-auto max-w-3xl text-center">
    {{
      include(
        'djfit:heading',
        {
          heading_text: heading_text|default('Choose your membership'),
          level: 2,
          text_color: 'default',
          text_size: 'heading-responsive-4xl',
          url: 'No URL',
          align: 'center'
        },
        with_context: false
      )
    }}

    {% if description|default('') is not empty %}
      <p class="mt-3 text-base text-muted-foreground md:text-lg">
        {{ description }}
      </p>
    {% endif %}
  </header>

  <div class="membership-pricing-table__cards grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {{
      include(
        'djfit:card-pricing',
        {
          heading_text: basic_title|default('Basic'),
          description: 'Best for getting started',
          price: basic_price|default('29'),
          currency_code: 'USD',
          currency_symbol: '$',
          symbol_position: 'before',
          text: basic_features|default('<ul><li>Community access</li><li>Monthly Q&A</li></ul>'),
          button_url: basic_button_url|default('/membership/basic'),
          button_label: basic_button_label|default('Choose Basic'),
          promote: false
        },
        with_context: false
      )
    }}

    {{
      include(
        'djfit:card-pricing',
        {
          heading_text: pro_title|default('Pro'),
          description: 'Most popular plan',
          price: pro_price|default('79'),
          currency_code: 'USD',
          currency_symbol: '$',
          symbol_position: 'before',
          text: pro_features|default('<ul><li>Everything in Basic</li><li>Weekly programming</li><li>Member events</li></ul>'),
          button_url: pro_button_url|default('/membership/pro'),
          button_label: pro_button_label|default('Choose Pro'),
          promote: true
        },
        with_context: false
      )
    }}

    {{
      include(
        'djfit:card-pricing',
        {
          heading_text: premium_title|default('Premium'),
          description: 'For accountability and coaching',
          price: premium_price|default('149'),
          currency_code: 'USD',
          currency_symbol: '$',
          symbol_position: 'before',
          text: premium_features|default('<ul><li>Everything in Pro</li><li>Priority coaching</li><li>Quarterly strategy call</li></ul>'),
          button_url: premium_button_url|default('/membership/premium'),
          button_label: premium_button_label|default('Choose Premium'),
          promote: false
        },
        with_context: false
      )
    }}
  </div>
</section>
