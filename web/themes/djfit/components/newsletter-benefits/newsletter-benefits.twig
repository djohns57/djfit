{#
/**
 * @file
 * Newsletter benefits – three icon cards showing what subscribers receive.
 */
#}
<section class="nl-benefits">
  <h2 class="nl-benefits__heading">{{ heading }}</h2>
  <div class="nl-benefits__grid">

    <div class="nl-benefits__card">
      <div class="nl-benefits__icon-wrap nl-benefits__icon-wrap--teal">
        <svg class="nl-benefits__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>
      <h3 class="nl-benefits__title">{{ card_1_title }}</h3>
      <p class="nl-benefits__text">{{ card_1_text }}</p>
    </div>

    <div class="nl-benefits__card">
      <div class="nl-benefits__icon-wrap nl-benefits__icon-wrap--green">
        <svg class="nl-benefits__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </div>
      <h3 class="nl-benefits__title">{{ card_2_title }}</h3>
      <p class="nl-benefits__text">{{ card_2_text }}</p>
    </div>

    <div class="nl-benefits__card">
      <div class="nl-benefits__icon-wrap nl-benefits__icon-wrap--slate">
        <svg class="nl-benefits__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
      </div>
      <h3 class="nl-benefits__title">{{ card_3_title }}</h3>
      <p class="nl-benefits__text">{{ card_3_text }}</p>
    </div>

  </div>
</section>
