{#
/**
 * @file
 * DJ Fit Video Library – dynamic video grid powered by Video nodes.
 *
 * Available variables:
 * - categories: array of {tid, name} taxonomy terms
 * - featured_video: single video data array (or NULL)
 * - videos: array of video data arrays
 *
 * Each video array: nid, title, description, url, video_url, thumbnail_url,
 *   categories (array of {tid, name}), access, access_label, duration, featured
 */
#}

{# Category filter tabs #}
<div class="videos-filters">
  <div class="videos-filters__container">
    <a href="/videos" class="videos-filters__tab videos-filters__tab--active">All</a>
    <a href="/videos?access=free" class="videos-filters__tab">Free</a>
    <a href="/videos?access=members_only" class="videos-filters__tab">Members only</a>
    {% for cat in categories %}
      <a href="/videos?category={{ cat.tid }}"
         class="videos-filters__tab">
        {{ cat.name }}
      </a>
    {% endfor %}
  </div>
</div>

{# Demo player section (featured video) #}
{% if featured_video %}
<section class="videos-demo">
  <div class="videos-demo__container">
    <h2 class="videos-demo__heading">Try Our Video Player</h2>
    <p class="videos-demo__subtitle">Experience our interactive video player with this free workout demo</p>

    <div class="videos-demo__player">
      <div class="videos-demo__player-media">
        {% if featured_video.thumbnail_url %}
          <img src="{{ featured_video.thumbnail_url }}" alt="{{ featured_video.title }}" class="videos-demo__player-thumb" loading="lazy" />
        {% endif %}
        <div class="videos-demo__player-overlay">
          <a href="{{ featured_video.url }}" class="videos-demo__play-btn" aria-label="Play demo video">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M5 3L19 12L5 21V3Z" fill="currentColor"/>
            </svg>
          </a>
        </div>
        <span class="videos-demo__badge videos-demo__badge--demo">DEMO</span>
      </div>
      <div class="videos-demo__player-info">
        <h3 class="videos-demo__player-title">{{ featured_video.title }}</h3>
        <p class="videos-demo__player-desc">{{ featured_video.description|striptags }}</p>
      </div>
    </div>
  </div>
</section>

<hr class="videos-divider" />
{% endif %}

{# All Videos grid #}
<section class="videos-grid">
  <h2 class="videos-grid__heading">All Videos</h2>

  <div class="videos-grid__container">
    {% for vid in videos %}
      <article class="video-card">
        <div class="video-card__media">
          {% if vid.thumbnail_url %}
            <img src="{{ vid.thumbnail_url }}" alt="{{ vid.title }}" class="video-card__thumb" loading="lazy" />
          {% else %}
            <svg class="video-card__placeholder-icon" viewBox="0 0 88 88" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="88" height="88" rx="4" fill="#e5e7eb"/>
              <path d="M36 52L42 44L48 50L54 42L60 52H36Z" fill="#9ca3af"/>
              <circle cx="40" cy="38" r="4" fill="#9ca3af"/>
              <rect x="28" y="28" width="32" height="32" rx="2" stroke="#9ca3af" stroke-width="2" fill="none"/>
            </svg>
          {% endif %}

          <div class="video-card__overlay">
            {% if vid.access == 'free' %}
              <div class="video-card__play-circle">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M5 3L19 12L5 21V3Z" fill="var(--hg-color-hero-gradient-start)"/>
                </svg>
              </div>
            {% else %}
              <div class="video-card__lock-circle">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="currentColor" stroke-width="2" fill="none"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                </svg>
              </div>
            {% endif %}
          </div>

          {% if vid.duration %}
            <span class="video-card__duration">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/>
                <path d="M12 6V12L16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
              </svg>
              {{ vid.duration }}
            </span>
          {% endif %}

          <span class="video-card__access video-card__access--{{ vid.access }}">
            {{ vid.access == 'free' ? 'FREE' : 'MEMBERS' }}
          </span>
        </div>

        <div class="video-card__body">
          <div class="video-card__tags">
            {% for cat in vid.categories %}
              <span class="video-card__tag">{{ cat.name }}</span>
            {% endfor %}
          </div>
          <h4 class="video-card__title">{{ vid.title }}</h4>
          <p class="video-card__desc">{{ vid.description|striptags }}</p>
        </div>

        <div class="video-card__footer">
          {% if vid.access == 'free' %}
            <a href="{{ vid.url }}" class="video-card__btn video-card__btn--watch">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M5 3L19 12L5 21V3Z" fill="currentColor"/>
              </svg>
              Watch Now
            </a>
          {% else %}
            <span class="video-card__btn video-card__btn--locked">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="currentColor" stroke-width="2" fill="none"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
              </svg>
              Members Only
            </span>
            <a href="/membership" class="video-card__upgrade">Upgrade to access</a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
