{# Video cards grid – dynamic content from Video nodes #}
<div class="home-videos__grid">
  {% for video in videos %}
    <a href="{{ video.url }}" class="home-videos__card" aria-label="{{ video.heading }}">
      <div class="home-videos__media">
        {% if video.image_url %}
          <img src="{{ video.image_url }}" alt="{{ video.heading }}" class="home-videos__thumb" loading="lazy" />
        {% else %}
          <div class="home-videos__placeholder">
            <svg class="home-videos__placeholder-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="8.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 16L8 11L13 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M14 15L17 12L21 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        {% endif %}

        <div class="home-videos__overlay">
          <div class="home-videos__play-btn">
            {% if video.locked %}
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="home-videos__icon">
                <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
                <path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="home-videos__icon">
                <polygon points="5,3 19,12 5,21" fill="currentColor"/>
              </svg>
            {% endif %}
          </div>
        </div>

        <span class="home-videos__badge home-videos__badge--{{ video.badge|lower }}">
          {{ video.badge }}
        </span>
      </div>

      <div class="home-videos__content">
        <h4 class="home-videos__card-heading">{{ video.heading }}</h4>
        <p class="home-videos__card-body">{{ video.body }}</p>
      </div>
    </a>
  {% endfor %}
</div>
